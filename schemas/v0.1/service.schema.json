{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service",
  "description": "OEMS v0.1 working draft; semantic constraints also apply.",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
